# ============================================================
# TRIXUL ETM Interface — Environment Configuration Template
# ============================================================
# Copy this file to .env and set the correct API URL.
# NEVER commit the actual .env file to Git.
# ============================================================

# --- For Web (browser on same machine) ---
EXPO_PUBLIC_API_URL=http://localhost:8000

# --- For Android Emulator (uncomment below, comment above) ---
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000

# --- For Physical Device on same WiFi (uncomment and set your LAN IP) ---
# EXPO_PUBLIC_API_URL=http://192.168.1.XXX:8000
