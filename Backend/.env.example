# ============================================================
# TRIXUL Backend — Environment Variables Template
# Copy this file to .env and replace dummy values with your local credentials.
# NEVER commit the actual .env file to version control.
# ============================================================

SECRET_KEY=your-django-secret-key-here
DEBUG=True

# Host & Security Configuration (Render / Production)
# ALLOWED_HOSTS=your-app-name.onrender.com,localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://your-app-name.onrender.com

# Database Configuration (PostGIS / PostgreSQL)
# Cloud / Production (e.g. Neon, Render):
# DATABASE_URL=postgresql://user:password@ep-xyz.region.aws.neon.tech/trixul_db?sslmode=require
DB_NAME=trixul_db
DB_USER=trixul_admin
DB_PASSWORD=your_secure_password_here
DB_HOST=localhost
DB_PORT=5432

# Cache Configuration (LocMem for dev, Redis for production)
CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
CACHE_URL=redis://127.0.0.1:6379/1
