# ============================================================
# TRIXUL Backend — Environment Variables Template
# Copy this file to .env and replace dummy values with your local credentials.
# NEVER commit the actual .env file to version control.
# ============================================================

SECRET_KEY=your-django-secret-key-here
DEBUG=True

# Database Configuration (PostGIS / PostgreSQL)
DB_NAME=trixul_db
DB_USER=trixul_admin
DB_PASSWORD=your_secure_password_here
DB_HOST=localhost
DB_PORT=5432

# Cache Configuration (LocMem for dev, Redis for production)
CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
CACHE_URL=redis://127.0.0.1:6379/1
