# ============================================================
# TRIXUL Backend — Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your local values.
# NEVER commit the actual .env file to Git.
# ============================================================

# Django core
SECRET_KEY=your-secret-key-here-change-this
DEBUG=True

# PostgreSQL + PostGIS database
DB_NAME=trixul_db
DB_USER=trixul_admin
DB_PASSWORD=your_secure_password_here
DB_HOST=localhost
DB_PORT=5432

# Cache backend
# Development (no Redis needed): leave as default (locmem)
# Production (with Redis): set to django.core.cache.backends.redis.RedisCache
CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
CACHE_URL=redis://127.0.0.1:6379/1
